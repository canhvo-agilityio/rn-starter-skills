#!/usr/bin/expect -f
# Drives `eas credentials` menus for eas-credentials.sh. Not meant to be run directly.
# Arguments come from the environment (EC_*), so nothing secret is ever on the command line —
# and nothing secret is ever typed: a password or Apple ID prompt stops the script.
#
# Exit codes: 0 done · 1 error · 2 needs the developer (a password / Apple login prompt)
#             3 stopped on a decision (already set up, key not valid on Apple's servers, unknown prompt)

set timeout 180
log_user 0
# EC_DEBUG=<file>: copy eas-cli's screen output there (menus, paths, ids — never secrets, since
# password prompts stop the script before anything is typed).
if {[info exists env(EC_DEBUG)] && $env(EC_DEBUG) ne ""} { log_file -a -noappend $env(EC_DEBUG) }
encoding system utf-8

set profile   $env(EC_PROFILE)
set platform  $env(EC_PLATFORM)
set keypath   [expr {[info exists env(EC_KEY)] ? $env(EC_KEY) : ""}]
set keyid     [expr {[info exists env(EC_KEY_ID)] ? $env(EC_KEY_ID) : ""}]
set issuer    [expr {[info exists env(EC_ISSUER_ID)] ? $env(EC_ISSUER_ID) : ""}]
set teamid    [expr {[info exists env(EC_TEAM_ID)] ? $env(EC_TEAM_ID) : ""}]
set queue     [split $env(EC_MENU) "|"]
set eascli    $env(EC_EAS_CLI)

proc say {msg} { puts "eas-credentials: $msg" }
proc clean {s} {
  regsub -all {\x1b\[[0-9;?]*[A-Za-z]} $s "" s
  regsub -all {\x1b[78]} $s "" s
  return $s
}
proc stop {code msg} { say $msg; catch {send "\003"}; exit $code }

# Wait until the screen is quiet (prompts re-renders the whole list), return the cleaned text.
proc settle {} {
  set acc ""
  while 1 {
    expect {
      -re {.+} { append acc $expect_out(buffer) }
      timeout { break }
      eof { break }
    }
    set ::timeout 1
  }
  set ::timeout 180
  return [clean $acc]
}

# Choose a list item whose title matches $pattern (regexp), counting from the pointer line.
proc choose {screen question pattern} {
  set at [string last $question $screen]
  if {$at < 0} { set at 0 }
  set lines [split [string range $screen $at end] "\n"]
  set items {}
  set cur -1
  foreach l [lrange $lines 1 end] {
    if {[regexp {^\s*$} $l]} { if {[llength $items]} break; continue }
    set ptr [regexp {❯} $l]
    regsub {^\s*❯?\s*} $l "" t
    set t [string trim $t]
    if {$t eq ""} continue
    if {$ptr} { set cur [llength $items] }
    lappend items $t
  }
  set target -1
  for {set i 0} {$i < [llength $items]} {incr i} {
    if {[regexp -- $pattern [lindex $items $i]]} { set target $i; break }
  }
  if {$target < 0} { stop 3 "no choice matching /$pattern/ in: [join $items { | }]" }
  if {$cur < 0} { set cur 0 }
  set d [expr {$target - $cur}]
  for {set i 0} {$i < abs($d)} {incr i} { send [expr {$d > 0 ? "\033\[B" : "\033\[A"}]; after 60 }
  after 100
  send "\r"
  say "chose: [lindex $items $target]"
  answered
}

# A prompt that's already answered is re-rendered as "✔ question › answer": ignore those.
proc active {} {
  global expect_out
  set lines [split [clean $expect_out(buffer)] "\n"]
  return [expr {[string first "\u2714" [lindex $lines end]] < 0}]
}

# After answering, wait for the answered line ("✔ question › answer") so the re-renders prompts
# draws while it handles the keys aren't read as a new question.
proc answered {} {
  expect {
    -timeout 30
    -re {\u2714[^\n]*\n} {}
    timeout {}
  }
}

proc next_menu {} {
  global queue
  if {[llength $queue]} {
    set item [lindex $queue 0]
    set queue [lrange $queue 1 end]
    return $item
  }
  return ""
}

set env(FORCE_COLOR) 0
spawn -noecho sh -c "$eascli credentials -p $platform"

while 1 {
  expect {
    -re {Which build profile do you want to configure\?} { if {![active]} continue;
      set s [settle]; choose $s "Which build profile" "^[string map {. \\.} $profile]\$"
    }
    -re {What do you want to do\?} { if {![active]} continue;
      set s [settle]
      set want [next_menu]
      if {$want eq ""} {
        if {[regexp {\nExit|❯\s*Exit|  Exit} $s]} { choose $s "What do you want to do" {^Exit$} } else { choose $s "What do you want to do" {^Go back$} }
      } else {
        choose $s "What do you want to do" "^[string map {( \\( ) \\) . \\. [ \\[ ] \\] + \\+} $want]"
      }
    }
    -re {Assign a name to your build credentials} { if {![active]} continue; after 200; send "\r"; say "name: default" ; answered }
    -re {already has a keystore configured\. Overwrite\?} { stop 3 "a keystore is already set up for this build profile — not overwritten" }
    -re {could not be parsed and may be corrupt} { stop 1 "EAS could not parse the keystore — wrong file or password" }
    -re {Select the [^\n]* to use for (your project|FCM V1):} { if {![active]} continue;
      set s [settle]; choose $s "Select the" {^\[(Add|Upload) a new}
    }
    -re {Reuse this [^\n]*\?} { if {![active]} continue;
      set s [settle]
      if {$keyid ne "" && [string first $keyid $s] >= 0} { send "y"; say "reuse: yes (same key id)" } else { send "n"; say "reuse: no" }
    }
    -re {Would you like to use this file\?} { if {![active]} continue; send "n"; say "detected file: not used" ; answered }
    -re {Choose the key you want to use:} { if {![active]} continue; set s [settle]; choose $s "Choose the key" {^None of the above$} }
    -re {(Path to Google Service Account file|Path to App Store Connect API Key|Path to P8 file|Path to ASC Api Key Path)[^\n]*:} { if {![active]} continue;
      if {$keypath eq ""} { stop 3 "asked for a key path, but none was given" }
      after 200; send -- "$keypath\r"; say "key path: $keypath"; answered
    }
    -re {(ASC Api Key ID|Key ID):} { if {![active]} continue;
      if {$keyid eq ""} { stop 3 "asked for a key id, but none was given" }
      after 200; send -- "$keyid\r"; say "key id: $keyid"; answered
    }
    -re {(Issuer ID)[^\n]*:} { if {![active]} continue; after 200; send -- "$issuer\r"; say "issuer id: $issuer" ; answered }
    -re {Apple Team ID:} { if {![active]} continue;
      if {$teamid eq ""} { stop 3 "asked for the Apple Team ID, but none was given" }
      after 200; send -- "$teamid\r"; say "team id: $teamid"; answered
    }
    -re {Select build credentials} { if {![active]} continue; set s [settle]; choose $s "Select build credentials" {\(Default\)|^Create A New Build Credential Configuration$} }
    -re {Team key \(recommended\)} { if {![active]} continue; set s [settle]; choose $s "" {^Team key} }
    -re {Generate a new [^\n]*\?} { if {![active]} continue; send "n"; say "generate: no (using the provided file)" ; answered }
    -re {Do you want to log in to your Apple account\?} { if {![active]} continue; send "n"; say "Apple login: no" ; answered }
    -re {(not valid on Apple's servers|could not be found on Apple's servers)} { stop 3 "Apple says the key isn't valid — check the key id, issuer id and team" }
    -re {([Pp]assword|Apple ID:)} { stop 2 "a password or Apple ID login is needed — the developer runs this step themselves" }
    -re {Press any key to continue} {
      # eas-cli pauses after an action, successful or not. Errors carry no secrets: report them.
      set lines [split [clean $expect_out(buffer)] "\n"]
      set msg [string trim [join [lrange $lines end-4 end-1] " "]]
      if {[regexp {\[GraphQL\]|Error|\u2716|failed|Cryptic error} $msg]} { stop 1 "eas-cli error: $msg" }
      say "eas-cli: $msg"
      send " "
    }
    -re {\n\? [^\n]+} { if {![active]} continue;
      set q [string trim [clean $expect_out(0,string)]]
      stop 3 "unexpected prompt: $q"
    }
    timeout { stop 3 "no response from eas-cli for 180 s" }
    eof {
      catch wait result
      set code [lindex $result 3]
      if {$code == 0} { say "done"; exit 0 }
      say "eas-cli exited with code $code"; exit 1
    }
  }
}
